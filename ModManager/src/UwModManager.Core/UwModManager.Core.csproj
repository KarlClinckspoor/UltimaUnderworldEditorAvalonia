<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- the editor's file formats and mod packages (format 2, docs/mod-format.md) -->
    <ProjectReference Include="../../../src/Underworld.Formats/Underworld.Formats.csproj" />
    <ProjectReference Include="../../../src/Underworld.Mods/Underworld.Mods.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- UltimaHacks' compiled hacks (MIT, John Glassmyer), for the GOG executables -->
    <EmbeddedResource Include="$(RepoRoot)hacks/uw1.hack" LogicalName="hacks/uw1.hack" />
    <EmbeddedResource Include="$(RepoRoot)hacks/uw2.hack" LogicalName="hacks/uw2.hack" />
    <EmbeddedResource Include="$(RepoRoot)hacks/LICENSE-UltimaHacks.txt" LogicalName="hacks/LICENSE-UltimaHacks.txt" />
  </ItemGroup>
</Project>
