<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UwModManager.App.ViewModels"
             xmlns:v="using:UwModManager.App.Views"
             x:Class="UwModManager.App.App"
             RequestedThemeVariant="Light">
  <!-- Fluent's accent buttons ("Use this", "Import a mod") in the editor's amber -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AccentButtonBackground">#9A6420</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver">#AD7430</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonBackgroundPressed">#83541A</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonForeground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonForegroundPointerOver">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonForegroundPressed">#FFFFFF</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AccentButtonBackground">#C9934C</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver">#D6A462</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonBackgroundPressed">#B07E3C</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonForeground">#15161A</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonForegroundPointerOver">#15161A</SolidColorBrush>
          <SolidColorBrush x:Key="AccentButtonForegroundPressed">#15161A</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- the editor's look (src/UwEditor.Look): its Dark and Light colours, styles and icon -->
    <StyleInclude Source="avares://UwEditor.Look/Styles.axaml" />
    <Style Selector=":is(Window)">
      <Setter Property="Icon" Value="avares://UwEditor.Look/Assets/icon-256.png" />
    </Style>
    <!-- the manager's own classes, on the editor's palette -->
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.2" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
      <Setter Property="Margin" Value="0,14,0,4" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="Run.dim">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="{DynamicResource Warn}" />
    </Style>
    <Style Selector="TextBlock.bad">
      <Setter Property="Foreground" Value="{DynamicResource Error}" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.sidebar">
      <Setter Property="Background" Value="{DynamicResource Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
  </Application.Styles>
  <Application.DataTemplates>
    <DataTemplate DataType="vm:TargetViewModel"><v:TargetView /></DataTemplate>
    <DataTemplate DataType="vm:LibraryViewModel"><v:LibraryView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:WelcomeViewModel"><v:WelcomeView /></DataTemplate>
  </Application.DataTemplates>
</Application>
