<Project>
  <!-- The editor's own settings first (AvaloniaVersion and the rest), then the manager's. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The manager's version (Settings). Raise the last number with every change to the app
         (0.2.1, then 0.2.2...). The editor has its own, in the Directory.Build.props above. -->
    <Version>0.2.3</Version>
    <Authors>Karl Clinckspoor</Authors>
    <Product>Ultima Underworlds Mod Manager</Product>
  </PropertyGroup>
</Project>
