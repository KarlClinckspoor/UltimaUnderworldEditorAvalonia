<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <None Include="TestData/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- GOG's game.gog, made from the test data -->
    <Compile Include="../../../tests/Shared/FakeGogImage.cs" Link="Shared/FakeGogImage.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/UwModManager.Core/UwModManager.Core.csproj" />
    <!-- the editor's core: its writers make the changes the tests package (and, later, the round trips) -->
    <ProjectReference Include="../../../src/UwEditor.Core/UwEditor.Core.csproj" />
  </ItemGroup>
</Project>
