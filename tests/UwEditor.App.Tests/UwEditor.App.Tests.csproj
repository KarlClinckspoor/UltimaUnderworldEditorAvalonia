<Project Sdk="Microsoft.NET.Sdk">
  <!-- Interface tests: the real main window in Avalonia's headless mode (no screen, no GL).
       They drive it with keys, clicks and its view model, and compare rendered frames of the
       interface (the 3D view stays blank here; tests/UwEditor.Screenshots covers it). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RollForward>Major</RollForward>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/UwEditor.App/UwEditor.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../UwEditor.Core.Tests/GameData.cs" Link="Shared/GameData.cs" />
  </ItemGroup>
</Project>
