<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:UwEditor.App"
        xmlns:ed="clr-namespace:UwEditor.Core.Editing;assembly=UwEditor.Core"
        x:Class="UwEditor.App.StringsWindow"
        x:DataType="app:StringsViewModel"
        Title="Strings"
        Width="1100" Height="720" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="Strings (STRINGS.PAK)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
      <TextBlock x:Name="StatusText" Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="1" Content="Revert this block" Click="OnRevert" IsEnabled="{Binding BlockChanged}" Margin="0,0,8,0" />
      <Button Grid.Column="2" x:Name="SaveButton" Content="Save STRINGS.PAK" Click="OnSave" IsEnabled="{Binding HasChanges}" />
    </Grid>
    <Grid ColumnDefinitions="330,16,*">
      <DockPanel Grid.Column="0">
        <TextBox DockPanel.Dock="Top" Text="{Binding BlockFilter}" PlaceholderText="Filter blocks: number or description" Margin="0,0,0,6" />
        <ListBox x:Name="BlockList" ItemsSource="{Binding Blocks}" SelectedItem="{Binding Block}" Background="{DynamicResource Panel}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="ed:StringBlockInfo">
              <TextBlock Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
          <TextBox x:Name="SearchBox" Text="{Binding Search}" PlaceholderText="Search this block (or every block with Ctrl+Enter)" KeyDown="OnSearchKey" />
          <Button Grid.Column="1" Content="Search all blocks" Click="OnSearchAll" Margin="8,0,0,0" />
        </Grid>
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
          <TextBlock Text="{Binding EditWhere}" Classes="muted" FontSize="11" />
          <TextBox x:Name="EditBox" Text="{Binding EditText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxHeight="200" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ApplyButton" Content="Apply" Click="OnApply" IsEnabled="{Binding HasString}" ToolTip.Tip="Keep the new text (Ctrl+Enter in the box)" />
            <Button x:Name="AddButton" Content="Add a string" Click="OnAdd" IsEnabled="{Binding HasBlock}" ToolTip.Tip="Add the text above as a new string at the end of the block" />
            <TextBlock Text="{Binding Error}" Foreground="#E07060" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
        <ListBox x:Name="StringList" ItemsSource="{Binding Rows}" SelectedItem="{Binding Row}" Background="{DynamicResource Panel}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="app:PakStringRow">
              <Grid ColumnDefinitions="92,*">
                <TextBlock Text="{Binding Where}" Classes="mono" FontSize="11" Foreground="{Binding WhereBrush}" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" MaxHeight="52" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
