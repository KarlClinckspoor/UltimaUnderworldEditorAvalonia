<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:UwEditor.App"
        x:Class="UwEditor.App.PlayerWindow"
        x:DataType="app:PlayerViewModel"
        Title="Player"
        Width="1180" Height="800" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="NumericUpDown">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="ShowButtonSpinner" Value="True" />
      <Setter Property="FormatString" Value="0" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="panel" Padding="12,8" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock x:Name="TitleText" Text="Player" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
        <TextBlock Grid.Column="1" x:Name="FileText" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button x:Name="SaveButton" Content="Save" Click="OnSave" MinWidth="80" HorizontalContentAlignment="Center"
                  ToolTip.Tip="Write PLAYER.DAT (Ctrl+S); the old file is kept as PLAYER.BKP" />
        </StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Classes="status">
      <TextBlock x:Name="StatusText" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- warnings, always in view -->
    <Border DockPanel.Dock="Right" Width="340" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
      <DockPanel Margin="12,10">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="CHECKS" Classes="h first" />
          <TextBlock x:Name="SummaryText" Text="{Binding WarningSummary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8" />
          <TextBlock Classes="muted" FontSize="11" Text="GAME DETECTS: UW2's end screen calls the character a cheat. NOT REACHABLE: creation and play never give it. NOTE: the game will change it, or it disagrees with another value." />
        </StackPanel>
        <ListBox x:Name="WarningList" ItemsSource="{Binding Warnings}" Background="Transparent" Margin="-4,8,-4,0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="app:WarningRow">
              <StackPanel>
                <TextBlock Text="{Binding Label}" Foreground="{Binding Brush}" FontSize="10" FontWeight="SemiBold" LetterSpacing="1" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <TabControl x:Name="Tabs" Margin="12,6,12,8">
      <TabItem Header="Character" x:Name="CharacterTab">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <Grid ColumnDefinitions="Auto,24,*" Margin="0,6,0,0">
            <!-- the character -->
            <StackPanel Grid.Column="0" Width="330" Spacing="4">
              <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" >
                <Border Grid.RowSpan="5" Classes="thumb" Width="88" Height="88" VerticalAlignment="Top" Margin="0,2,12,0">
                  <Image x:Name="PortraitImage" Source="{Binding Portrait}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                </Border>
                <TextBox Grid.Column="1" x:Name="NameBox" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Name" Margin="0,0,0,4" />
                <ComboBox Grid.Column="1" Grid.Row="1" x:Name="ClassBox" ItemsSource="{Binding ClassNames}" SelectedIndex="{Binding ClassIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                <ComboBox Grid.Column="1" Grid.Row="2" x:Name="SexBox" ItemsSource="{Binding Sexes}" SelectedIndex="{Binding SexIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                <ComboBox Grid.Column="1" Grid.Row="3" x:Name="HandBox" ItemsSource="{Binding Hands}" SelectedIndex="{Binding HandIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                <Grid Grid.Column="1" Grid.Row="4" ColumnDefinitions="*,120">
                  <TextBlock Classes="label" Text="Portrait (body)" />
                  <NumericUpDown Grid.Column="1" x:Name="BodyBox" Value="{Binding Body, Mode=TwoWay}" Minimum="0" Maximum="7" />
                </Grid>
              </Grid>

              <TextBlock Text="ATTRIBUTES" Classes="h" />
              <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto,Auto" >
                <TextBlock Classes="label" Text="Strength" />
                <NumericUpDown Grid.Column="1" x:Name="StrengthBox" Value="{Binding Strength, Mode=TwoWay}" Minimum="0" Maximum="255" Margin="0,0,0,4" />
                <TextBlock Grid.Row="1" Classes="label" Text="Dexterity" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="DexterityBox" Value="{Binding Dexterity, Mode=TwoWay}" Minimum="0" Maximum="255" Margin="0,0,0,4" />
                <TextBlock Grid.Row="2" Classes="label" Text="Intelligence" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="IntelligenceBox" Value="{Binding Intelligence, Mode=TwoWay}" Minimum="0" Maximum="255" />
              </Grid>

              <TextBlock Text="CONDITION" Classes="h" />
              <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" >
                <TextBlock Classes="label" Text="Vitality" />
                <NumericUpDown Grid.Column="1" Value="{Binding Vitality, Mode=TwoWay}" Minimum="0" Maximum="255" Margin="0,0,0,4" />
                <TextBlock Grid.Row="1" Classes="label" Text="Maximum vitality" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MaxVitality, Mode=TwoWay}" Minimum="0" Maximum="255" Margin="0,0,0,4" />
                <TextBlock Grid.Row="2" Classes="label" Text="Mana" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Mana, Mode=TwoWay}" Minimum="0" Maximum="255" Margin="0,0,0,4" />
                <TextBlock Grid.Row="3" Classes="label" Text="Maximum mana" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding MaxMana, Mode=TwoWay}" Minimum="0" Maximum="255" Margin="0,0,0,4" />
                <TextBlock Grid.Row="4" Classes="label" Text="Hunger (255 full)" />
                <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Hunger, Mode=TwoWay}" Minimum="0" Maximum="255" Margin="0,0,0,4" />
                <TextBlock Grid.Row="5" Classes="label" Text="Fatigue" />
                <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding Fatigue, Mode=TwoWay}" Minimum="0" Maximum="255" Margin="0,0,0,4" />
                <TextBlock Grid.Row="6" Classes="label" Text="Carrying capacity" />
                <NumericUpDown Grid.Row="6" Grid.Column="1" Value="{Binding MaxWeight, Mode=TwoWay}" Minimum="0" Maximum="65535" />
              </Grid>

              <TextBlock Text="EXPERIENCE" Classes="h" />
              <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto,Auto" >
                <TextBlock Classes="label" Text="Level" />
                <NumericUpDown Grid.Column="1" x:Name="LevelBox" Value="{Binding Level, Mode=TwoWay}" Minimum="0" Maximum="255" Margin="0,0,0,4" />
                <TextBlock Grid.Row="1" Classes="label" Text="Experience" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Experience, Mode=TwoWay}" Minimum="0" Maximum="400000000" Margin="0,0,0,4" />
                <TextBlock Grid.Row="2" Classes="label" Text="Skill points to spend" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SkillPoints, Mode=TwoWay}" Minimum="0" Maximum="255" />
              </Grid>
              <TextBlock Text="{Binding Derived}" Classes="muted" FontSize="11" Margin="0,8,0,0" />
              <Button x:Name="RecomputeButton" Content="Set the maxima as the game computes them" Click="OnRecompute" Margin="0,6,0,0"
                      ToolTip.Tip="Maximum vitality, mana and carrying capacity from the attributes, level and Mana skill (game/SKILLS.C player_compute)" />
            </StackPanel>

            <!-- skills -->
            <StackPanel Grid.Column="2">
              <TextBlock Text="SKILLS" Classes="h first" />
              <ItemsControl x:Name="SkillList" ItemsSource="{Binding Skills}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="app:SkillRow">
                    <Grid ColumnDefinitions="*,110" Margin="0,0,16,4">
                      <TextBlock Classes="label" Text="{Binding Name}" />
                      <NumericUpDown Grid.Column="1" Value="{Binding Value, Mode=TwoWay}" Minimum="0" Maximum="255" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Inventory" x:Name="InventoryTab">
        <Grid ColumnDefinitions="*,12,330" Margin="0,6,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="0,0,0,6"
                       Text="What the player carries: worn and held objects and the pack (slots), with what is inside containers. Saving renumbers the objects as the game does." />
            <TreeView x:Name="ItemTree" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="{DynamicResource Bg}">
              <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="app:ItemNode">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapInterpolationMode="None" />
                    <TextBlock Text="{Binding Text}" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </DockPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Text="SELECTED OBJECT" Classes="h first" />
            <StackPanel IsVisible="{Binding HasItem}" Spacing="4">
              <Grid ColumnDefinitions="*,140" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Classes="label" Text="Item id" />
                <NumericUpDown Grid.Column="1" x:Name="ItemIdBox" Value="{Binding ItemId, Mode=TwoWay}" Minimum="0" Maximum="511" Margin="0,0,0,2" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ItemName}" FontSize="12" Margin="0,0,0,6" />
                <TextBlock Grid.Row="2" Classes="label" Text="Quality" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Quality, Mode=TwoWay}" Minimum="0" Maximum="63" Margin="0,0,0,4" />
                <TextBlock Grid.Row="3" Classes="label" Text="Owner" />
                <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Owner, Mode=TwoWay}" Minimum="0" Maximum="63" Margin="0,0,0,4" />
                <TextBlock Grid.Row="4" Classes="label" Text="Quantity / special" />
                <NumericUpDown Grid.Row="4" Grid.Column="1" x:Name="LinkBox" Value="{Binding Link, Mode=TwoWay}" Minimum="0" Maximum="1023" IsEnabled="{Binding IsQuantity}" Margin="0,0,0,4" />
                <TextBlock Grid.Row="5" Classes="label" Text="Flags" />
                <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding ItemFlags, Mode=TwoWay}" Minimum="0" Maximum="7" />
              </Grid>
              <TextBlock Text="{Binding LinkMeaning}" Classes="muted" FontSize="11" />
              <CheckBox Content="Link is a quantity or special (not a container)" IsChecked="{Binding IsQuantity, Mode=TwoWay}" />
              <CheckBox Content="Enchanted" IsChecked="{Binding Enchanted, Mode=TwoWay}" />
              <CheckBox Content="Invisible" IsChecked="{Binding Invisible, Mode=TwoWay}" />
              <StackPanel IsVisible="{Binding IsTop}">
                <TextBlock Classes="label" Text="Slot" Margin="0,4,0,2" />
                <ComboBox x:Name="SlotBox" ItemsSource="{Binding SlotChoices}" SelectedIndex="{Binding SlotIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" />
              </StackPanel>
              <Button x:Name="DeleteButton" Content="Remove from the inventory" Click="OnDelete" Margin="0,6,0,0" />
            </StackPanel>
            <TextBlock Text="ADD AN OBJECT" Classes="h" />
            <Grid ColumnDefinitions="*,140">
              <TextBlock Classes="label" Text="Item id" />
              <NumericUpDown Grid.Column="1" x:Name="NewItemBox" Value="{Binding NewItem, Mode=TwoWay}" Minimum="0" Maximum="511" />
            </Grid>
            <TextBlock Text="{Binding NewItemName}" FontSize="12" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button x:Name="AddPackButton" Content="Add to the pack" Click="OnAddPack" />
              <Button x:Name="AddIntoButton" Content="Add into selected" Click="OnAddInto" IsEnabled="{Binding HasItem}" ToolTip.Tip="Into the selected container, or the container the selected object is in" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
