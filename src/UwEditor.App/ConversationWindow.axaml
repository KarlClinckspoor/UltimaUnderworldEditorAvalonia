<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:UwEditor.App"
        xmlns:ae="using:AvaloniaEdit"
        x:Class="UwEditor.App.ConversationWindow"
        x:DataType="app:ConversationViewModel"
        Title="Conversations"
        Width="1280" Height="820" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <!-- toolbar -->
    <Border DockPanel.Dock="Top" Classes="panel" Padding="12,8" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="Conversations" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button x:Name="SimulateButton" Content="Simulate…" Click="OnSimulate" IsEnabled="{Binding HasSelection}"
                  ToolTip.Tip="Run this conversation as the game would, choosing from its menus (Ctrl+R). On the Dialogue tab with edits not applied, it runs the text as typed. Nothing is written to the game." />
          <Button x:Name="GraphButton" Content="Graph…" Click="OnGraph" IsEnabled="{Binding HasSelection}"
                  ToolTip.Tip="Show this conversation's flow as a graph: what the NPC says, the menus, and where each answer leads." />
          <Button x:Name="GlobalsButton" Content="Global variables…" Click="OnGlobals" ToolTip.Tip="Show the quest flags, game variables and private globals that conversations read and write (Ctrl+G)." />
          <Button x:Name="RevertButton" Content="Revert conversation" Click="OnRevert" IsEnabled="{Binding HasSelection}"
                  ToolTip.Tip="Discard this conversation's unsaved changes to its script and its strings." />
          <Button x:Name="SaveButton" Content="Save" Click="OnSave" MinWidth="80" HorizontalContentAlignment="Center"
                  ToolTip.Tip="Write CNV.ARK and STRINGS.PAK in DATA (Ctrl+S). The old files are kept as CNV.ARK.BKP and STRINGS.PAK.BKP." />
        </StackPanel>
      </Grid>
    </Border>

    <!-- status -->
    <Border DockPanel.Dock="Bottom" Classes="status">
      <TextBlock x:Name="StatusText" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
    </Border>

    <Grid x:Name="Columns" ColumnDefinitions="280,4,*">
      <!-- the list -->
      <DockPanel Grid.Column="0" Background="{DynamicResource Panel}">
        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Margin="8" Text="{Binding Filter}" PlaceholderText="Filter by slot, name or text" />
        <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="app:ConversationRow">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="  ●" Classes="badge" IsVisible="{Binding Changed}" ToolTip.Tip="Changed but not saved." />
                </StackPanel>
                <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <!-- the conversation -->
      <DockPanel Grid.Column="2" Margin="12,8,12,8">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <TextBlock x:Name="HeaderText" Text="{Binding Header}" Classes="title" />
          <TextBlock Text="{Binding Subheader}" Classes="muted" />
        </StackPanel>
        <TabControl x:Name="Tabs" SelectedIndex="{Binding Tab}" Padding="0,6,0,0">
          <TabItem Header="Dialogue" x:Name="DialogueTab">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6"
                         Text="The conversation in the conversation language. Edit it and Apply (Ctrl+Enter) to compile it into the conversation; mistakes are underlined as you type. Simulate (Ctrl+R) runs the text as typed. F2 renames, F12 or Ctrl+click goes to a function, Ctrl+F finds, Ctrl+L goes to a line, Tab and Shift+Tab indent." />
              <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" ItemSpacing="8" LineSpacing="6" Margin="0,0,0,6">
                <Button x:Name="ApplyDialogueButton" Content="Apply" Click="OnApplyDialogue" IsEnabled="{Binding DialogueChanged}" FontWeight="SemiBold"
                        ToolTip.Tip="Compile the text into the conversation and its new strings (Ctrl+Enter). Refused while the text has errors. Nothing is written to the game until you save." />
                <Button x:Name="RevertAppliedButton" Content="Revert to last applied" Click="OnRevertToApplied" IsEnabled="{Binding DialogueChanged}"
                        ToolTip.Tip="Throw away the edits not applied: the text goes back to the conversation as it is now (Ctrl+Z in the text brings them back)." />
                <Button x:Name="RevertOriginalButton" Content="Revert to the original" Click="OnRevertToOriginal" IsEnabled="{Binding HasSelection}"
                        ToolTip.Tip="Put back the conversation and its strings as shipped (CNV.ARK.ORIG and STRINGS.PAK.ORIG, kept the first time the editor saved, or the files as they are). Undo apply steps back." />
                <Button x:Name="UndoApplyButton" Content="Undo apply" Click="OnUndoApply" IsEnabled="{Binding CanUndoApply}"
                        ToolTip.Tip="Put this conversation back as it was before the last Apply or revert (its code and its strings)." />
                <Button x:Name="RedoApplyButton" Content="Redo apply" Click="OnRedoApply" IsEnabled="{Binding CanRedoApply}" />
                <CheckBox x:Name="WrapBox" Content="Wrap long lines" IsCheckedChanged="OnWrapChanged"
                          ToolTip.Tip="Break lines longer than the editor is wide onto more lines on screen, indented under their start. Only the display: the text keeps its lines (the line numbers count them)." />
                <CheckBox x:Name="HideUnusedBox" Content="Fold uncalled functions" IsChecked="True"
                          IsCheckedChanged="OnHideUnusedChanged" ToolTip.Tip="The compiler adds a small library of functions to every conversation, and most of them are never called. Folded, they stay in the text (they are part of the conversation) as one line." />
                <Button x:Name="ExportNamesButton" Content="Export names…" Click="OnExportNames"
                        ToolTip.Tip="Write the names (the shipped ones with your renames folded in) as a names file, the format of docs/conversations/names-uw1.json." />
              </WrapPanel>
              <Grid RowDefinitions="*,4,96">
                <ae:TextEditor x:Name="SourceEditor" Grid.Row="0" ShowLineNumbers="True" FontFamily="{DynamicResource Mono}" FontSize="12"
                               Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" LineNumbersForeground="{DynamicResource Muted}"
                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" WordWrap="False" />
                <GridSplitter Grid.Row="1" ResizeDirection="Rows" />
                <DockPanel Grid.Row="2">
                  <TextBlock x:Name="ProblemSummaryText" DockPanel.Dock="Top" Text="{Binding ProblemSummary}" Classes="muted" FontSize="11" Margin="2,4,0,2" TextWrapping="Wrap" />
                  <ListBox x:Name="ProblemList" ItemsSource="{Binding Problems}" Background="{DynamicResource Bg}" DoubleTapped="OnProblemDoubleTapped" FontSize="12">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="6,1" />
                        <Setter Property="MinHeight" Value="0" />
                      </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="app:ProblemRow">
                        <Grid ColumnDefinitions="64,110,*">
                          <TextBlock Grid.Column="0" Text="{Binding Kind}" Foreground="{Binding Brush}" FontWeight="SemiBold" />
                          <TextBlock Grid.Column="1" Text="{Binding Where}" Foreground="{DynamicResource Muted}" FontFamily="{DynamicResource Mono}" FontSize="11" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Grid>
            </DockPanel>
          </TabItem>

          <TabItem Header="Strings" x:Name="StringsTab">
            <DockPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Classes="muted" VerticalAlignment="Center"
                           Text="This conversation's block of STRINGS.PAK. Edit a string in place; the game fills in @ variables such as @GS8. A new string takes the next number, ready for the script to say." />
                <Button Grid.Column="1" x:Name="AddStringButton" Content="Add string" Click="OnAddString" Margin="8,0,0,0" IsEnabled="{Binding HasSelection}" />
              </Grid>
              <ListBox x:Name="StringList" ItemsSource="{Binding Strings}" Background="{DynamicResource Bg}">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="4,2" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="app:StringRow">
                    <Grid ColumnDefinitions="40,*">
                      <StackPanel Grid.Column="0" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Number}" FontFamily="{DynamicResource Mono}" FontSize="11" Foreground="{DynamicResource Muted}" />
                        <TextBlock Text="●" Classes="badge" Margin="0" IsVisible="{Binding Changed}" ToolTip.Tip="Changed but not saved." />
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBox Text="{Binding Text, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" FontSize="12" MinHeight="28" />
                        <TextBlock Text="{Binding Uses}" Classes="muted" FontSize="10" IsVisible="{Binding HasUses}" Margin="2,1,0,0" />
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Warn}" FontSize="11" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>

          <TabItem Header="Script" x:Name="ScriptTab">
            <DockPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="The code, one instruction per line (the opcodes of conv.h); the comments show addresses and strings. Apply assembles the text into the conversation. F2 renames the function or label at the caret." />
                <Button Grid.Column="1" x:Name="ApplyScriptButton" Content="Apply" Click="OnApplyScript" Margin="8,0,0,0" IsEnabled="{Binding ScriptChanged}"
                        ToolTip.Tip="Assemble the text into the conversation (Ctrl+Enter)." />
                <Button Grid.Column="2" Content="Undo edits" Click="OnResetScript" Margin="8,0,0,0" IsEnabled="{Binding ScriptChanged}" />
              </Grid>
              <TextBlock DockPanel.Dock="Bottom" Text="{Binding ScriptError}" Foreground="{DynamicResource Warn}" IsVisible="{Binding HasScriptError}" Margin="0,6,0,0" TextWrapping="Wrap" />
              <TextBox x:Name="ScriptBox" Text="{Binding Script, Mode=TwoWay}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                       FontFamily="{DynamicResource Mono}" FontSize="12" Background="{DynamicResource Bg}"
                       ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </DockPanel>
          </TabItem>

          <TabItem Header="Who talks" x:Name="UsersTab">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="0,0,0,6"
                         Text="The creatures in the levels that talk through this slot (by their whoami, or through a generic slot when whoami is 0). Double-click one to go to it." />
              <ListBox x:Name="UserList" ItemsSource="{Binding Users}" Background="{DynamicResource Bg}" DoubleTapped="OnUserDoubleTapped">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="app:UserRow">
                    <TextBlock Text="{Binding Text}" FontSize="12" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
