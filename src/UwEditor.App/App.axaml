<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UwEditor.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://UwEditorAvalonia/Styles.axaml" />
    <!-- every window carries the black sword (UW1 item 0x00C, from OBJECTS.GR) -->
    <Style Selector=":is(Window)">
      <Setter Property="Icon" Value="avares://UwEditorAvalonia/Assets/icon-256.png" />
    </Style>
  </Application.Styles>
</Application>
