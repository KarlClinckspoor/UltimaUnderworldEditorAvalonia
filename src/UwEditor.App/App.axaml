<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UwEditor.App.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <!-- the look shared with the mod manager (src/UwEditor.Look) -->
    <StyleInclude Source="avares://UwEditor.Look/Styles.axaml" />
    <!-- the conversation editor's Dialogue tab (AvaloniaEdit) -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <!-- every window carries the black sword (UW1 item 0x00C, from OBJECTS.GR) -->
    <Style Selector=":is(Window)">
      <Setter Property="Icon" Value="avares://UwEditor.Look/Assets/icon-256.png" />
    </Style>
  </Application.Styles>
</Application>
