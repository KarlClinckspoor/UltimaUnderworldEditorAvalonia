<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>UwEditorAvalonia</AssemblyName>
    <RootNamespace>UwEditor.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <!-- the conversation editor's Dialogue tab: AvaloniaEdit (MIT), the Avalonia port of AvalonEdit; 12.0.0 is the line for Avalonia 12 -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <!-- Tools > Sound and music plays speech and effects through OpenAL Soft (LGPL, loaded at run time) -->
    <PackageReference Include="Silk.NET.OpenAL" Version="$(SilkVersion)" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../docs/MANUAL.md" LogicalName="MANUAL.md" />
    <EmbeddedResource Include="../../docs/examples/uw1-zones.json" LogicalName="uw1-zones.example.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../UwEditor.Core/UwEditor.Core.csproj" />
    <ProjectReference Include="../UwEditor.Render/UwEditor.Render.csproj" />
    <!-- the colours, styles, Compact layout and icons, shared with the mod manager -->
    <ProjectReference Include="../UwEditor.Look/UwEditor.Look.csproj" />
  </ItemGroup>
</Project>
