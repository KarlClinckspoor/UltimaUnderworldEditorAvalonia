<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>UwEditorFree</AssemblyName>
    <RootNamespace>UwEditor.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../docs/MANUAL.md" LogicalName="MANUAL.md" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../UwEditor.Core/UwEditor.Core.csproj" />
    <ProjectReference Include="../UwEditor.Render/UwEditor.Render.csproj" />
  </ItemGroup>
</Project>
