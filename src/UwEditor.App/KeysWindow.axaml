<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:UwEditor.App"
        xmlns:ed="clr-namespace:UwEditor.Core.Editing;assembly=UwEditor.Core"
        x:Class="UwEditor.App.KeysWindow"
        x:DataType="app:KeysViewModel"
        Title="Keys and locks"
        Width="980" Height="640" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="Keys and locks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
    <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,10"
               Text="A key opens a lock when its owner field equals the lock's number (link &amp; 0x1FF; obj/USEITEMS.C). Keys of a number share one description: STRINGS.PAK block 5, string 100 + the number. Double-click a key or lock to go to it." />
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,10,0,0">
      <TextBlock x:Name="StatusText" Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <Button Grid.Column="1" Content="Read the levels again" Click="OnRefresh" Margin="0,0,8,0" />
      <Button Grid.Column="2" x:Name="SaveButton" Content="Save STRINGS.PAK" Click="OnSave" IsEnabled="{Binding HasChanges}" />
    </Grid>
    <Grid ColumnDefinitions="340,16,*">
      <ListBox x:Name="GroupList" Grid.Column="0" ItemsSource="{Binding Groups}" SelectedItem="{Binding Selected}" Background="{DynamicResource Panel}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="ed:KeyGroup">
            <StackPanel>
              <TextBlock Text="{Binding Summary}" FontSize="12" />
              <TextBlock Text="{Binding Text}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <DockPanel Grid.Column="2" IsVisible="{Binding HasSelection}">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
          <TextBlock Classes="h first" Text="DESCRIPTION OF THE KEYS" />
          <TextBlock Text="{Binding TextWhere}" Classes="muted" FontSize="11" />
          <TextBox x:Name="TextBox" Text="{Binding EditText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ApplyButton" Content="Apply" Click="OnApply" ToolTip.Tip="Keep the new text (saved with Save STRINGS.PAK)" />
            <TextBlock Text="{Binding TextError}" Foreground="#E07060" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
        <Grid RowDefinitions="Auto,*,Auto,*" Margin="0,10,0,0">
          <TextBlock Grid.Row="0" Classes="h" Text="KEYS" />
          <ListBox Grid.Row="1" x:Name="KeyList" ItemsSource="{Binding Keys}" DoubleTapped="OnPlaceDoubleTapped" Background="{DynamicResource Panel}" />
          <TextBlock Grid.Row="2" Classes="h" Text="LOCKS" />
          <ListBox Grid.Row="3" x:Name="LockList" ItemsSource="{Binding Locks}" DoubleTapped="OnPlaceDoubleTapped" Background="{DynamicResource Panel}" />
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
