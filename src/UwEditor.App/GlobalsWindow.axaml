<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:UwEditor.App"
        x:Class="UwEditor.App.GlobalsWindow"
        x:DataType="app:GlobalsViewModel"
        Title="Global variables"
        Width="1180" Height="760" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="panel" Padding="12,8" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Text="Global variables" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
          <TextBlock Grid.Column="1" x:Name="SourceText" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
            <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefresh" ToolTip.Tip="Read the conversations and the save's files again, for example after editing scripts." />
            <Button x:Name="SaveButton" Content="Save values" Click="OnSave" ToolTip.Tip="Write PLAYER.DAT and BGLOBALS.DAT in the save (Ctrl+S). The old files are kept as .BKP." />
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBox x:Name="FilterBox" Text="{Binding Filter}" Width="280" PlaceholderText="Filter by number, name or conversation" />
          <ComboBox x:Name="KindBox" ItemsSource="{Binding Kinds}" SelectedIndex="{Binding KindIndex}" MinWidth="200" />
          <CheckBox x:Name="UsedBox" Content="Only those used by conversations" IsChecked="{Binding OnlyUsed}" />
          <CheckBox x:Name="SetBox" Content="Only non-zero" IsChecked="{Binding OnlySet}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="status">
      <TextBlock x:Name="StatusText" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
    </Border>

    <Grid ColumnDefinitions="*,4,340">
      <DockPanel Grid.Column="0">
        <!-- column headers -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="110,110,*,90,150,150" Margin="10,6,18,4">
          <TextBlock Grid.Column="0" Text="KIND" Classes="section" Margin="0" />
          <TextBlock Grid.Column="1" Text="NUMBER" Classes="section" Margin="0" />
          <TextBlock Grid.Column="2" Text="NAME" Classes="section" Margin="0" />
          <TextBlock Grid.Column="3" Text="VALUE" Classes="section" Margin="0" />
          <TextBlock Grid.Column="4" Text="READ BY" Classes="section" Margin="0" />
          <TextBlock Grid.Column="5" Text="WRITTEN BY" Classes="section" Margin="0" />
        </Grid>
        <ListBox x:Name="VarList" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="{DynamicResource Bg}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="10,1" />
              <Setter Property="MinHeight" Value="0" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="app:GlobalRow">
              <Grid ColumnDefinitions="110,110,*,90,150,150" ToolTip.Tip="{Binding Tip}">
                <TextBlock Grid.Column="0" Text="{Binding Kind}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Number}" FontSize="12" FontFamily="{DynamicResource Mono}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="3" Text="{Binding Value, Mode=TwoWay}" IsReadOnly="{Binding ReadOnly}" IsVisible="{Binding ShowValue}" FontSize="12" FontFamily="{DynamicResource Mono}"
                         MinHeight="0" Height="24" Padding="6,0" VerticalContentAlignment="Center" Margin="0,1,8,1" />
                <TextBlock Grid.Column="4" Text="{Binding ReadBy}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="5" Text="{Binding WrittenBy}" FontSize="11" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <DockPanel Grid.Column="2" Background="{DynamicResource Panel}">
        <StackPanel DockPanel.Dock="Top" Margin="12,10,12,6">
          <TextBlock Text="SELECTED" Classes="h first" />
          <TextBlock x:Name="DetailText" Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" />
          <TextBlock Text="USED BY" Classes="h" />
          <TextBlock Classes="muted" FontSize="11" Text="Double-click to open the conversation at that line." />
        </StackPanel>
        <ListBox x:Name="UseList" ItemsSource="{Binding Uses}" Background="Transparent" DoubleTapped="OnUseDoubleTapped" Margin="4,0,4,8">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="app:UseRow">
              <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
