<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:UwEditor.App"
        x:Class="UwEditor.App.FindWindow"
        x:DataType="app:FindViewModel"
        Title="Find in all levels"
        Width="640" Height="560" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="Find in all levels" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,8">
      <TextBox x:Name="QueryBox" Grid.Column="0" Text="{Binding Text}" PlaceholderText="Name, text, NPC name, #index or 0x item id" />
      <Button x:Name="SearchButton" Grid.Column="1" Content="Search" Click="OnSearch" IsDefault="True" Margin="8,0,0,0" MinWidth="88"
              HorizontalContentAlignment="Center" IsEnabled="{Binding !Busy}" />
      <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
        <ComboBox x:Name="KindBox" ItemsSource="{Binding Kinds}" SelectedIndex="{Binding KindIndex}" MinWidth="240" />
        <CheckBox x:Name="EnchantedBox" Content="Enchanted only" IsChecked="{Binding EnchantedOnly}" />
      </StackPanel>
    </Grid>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBlock x:Name="StatusText" Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Go to" Click="OnGoTo" IsEnabled="{Binding HasSelection}" MinWidth="88" HorizontalContentAlignment="Center" />
    </Grid>
    <ListBox x:Name="Results" ItemsSource="{Binding Hits}" SelectedItem="{Binding Selected}" DoubleTapped="OnResultDoubleTapped"
             Background="{DynamicResource Panel}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="app:HitRow">
          <Grid ColumnDefinitions="Auto,*">
            <Image Grid.Column="0" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Top"
                   RenderOptions.BitmapInterpolationMode="None" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" IsVisible="{Binding HasDetail}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
