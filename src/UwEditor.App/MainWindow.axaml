<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:UwEditor.App"
        xmlns:core="clr-namespace:UwEditor.Core;assembly=UwEditor.Core"
        x:Class="UwEditor.App.MainWindow"
        x:DataType="app:MainViewModel"
        Title="Underworld Editor"
        Width="1440" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">


  <DockPanel>
    <!-- menu -->
    <Menu DockPanel.Dock="Top" x:Name="MainMenu">
      <MenuItem Header="_File">
        <MenuItem Header="_Open game folder…" InputGesture="Ctrl+O" Click="OnOpen" />
        <MenuItem Header="Open _recent" x:Name="RecentMenu" />
        <Separator />
        <MenuItem Header="_Checkpoints…" Click="OnCheckpoints" IsEnabled="{Binding HasGame}" />
        <Separator />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="{Binding UndoText}" InputGesture="Ctrl+Z" Click="OnUndo" IsEnabled="{Binding CanUndo}" />
        <MenuItem Header="{Binding RedoText}" InputGesture="Ctrl+Y" Click="OnRedo" IsEnabled="{Binding CanRedo}" />
        <Separator />
        <MenuItem Header="_Add an object…" InputGesture="Insert" Click="OnAddObject" IsEnabled="{Binding HasGame}" />
        <MenuItem Header="_Delete the object" InputGesture="Delete" Click="OnDeleteObject" IsEnabled="{Binding HasObject}" />
        <Separator />
        <MenuItem Header="Move the new-game _start here" Click="OnMoveStart" IsEnabled="{Binding HasTile}" />
        <MenuItem Header="Move the _player here" Click="OnMovePlayer" IsEnabled="{Binding HasTile}" />
        <MenuItem Header="Choose the selected trap's _target…" Click="OnPickTarget" IsEnabled="{Binding HasTargetSquare}" />
        <Separator />
        <MenuItem Header="_Save the levels" InputGesture="Ctrl+S" Click="OnSaveLevels" IsEnabled="{Binding HasLevelChanges}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Ceiling" ToggleType="CheckBox" IsChecked="{Binding ShowCeiling, Mode=TwoWay}" InputGesture="G" />
        <MenuItem Header="_Objects" ToggleType="CheckBox" IsChecked="{Binding ShowObjects, Mode=TwoWay}" />
        <MenuItem Header="_Invisible objects" ToggleType="CheckBox" IsChecked="{Binding ShowInvisible, Mode=TwoWay}" />
        <MenuItem Header="_Traps and triggers" ToggleType="CheckBox" IsChecked="{Binding ShowTraps, Mode=TwoWay}" />
        <MenuItem Header="_Darkness" ToggleType="CheckBox" IsChecked="{Binding Darkness, Mode=TwoWay}" />
        <MenuItem Header="3D _models" ToggleType="CheckBox" IsChecked="{Binding ShowModels, Mode=TwoWay}" InputGesture="M" />
        <MenuItem Header="_Grid" ToggleType="CheckBox" IsChecked="{Binding ShowGrid, Mode=TwoWay}" InputGesture="H" />
        <Separator />
        <MenuItem Header="_Frame the selection" InputGesture="F" Click="OnFrame" />
        <MenuItem Header="Look _straight down" InputGesture="T" Click="OnTopDown" />
        <MenuItem Header="Go to the _start" InputGesture="Home" Click="OnGoToStart" />
        <MenuItem Header="_First person" InputGesture="P" Click="OnFirstPerson" />
        <Separator />
        <MenuItem Header="Colour _scheme">
          <MenuItem x:Name="DarkThemeItem" Header="_Dark" ToggleType="Radio" GroupName="theme" Click="OnDarkTheme" />
          <MenuItem x:Name="LightThemeItem" Header="_Light" ToggleType="Radio" GroupName="theme" Click="OnLightTheme" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Level">
        <MenuItem Header="_Previous level" InputGesture="PageUp" Click="OnPreviousLevel" />
        <MenuItem Header="_Next level" InputGesture="PageDown" Click="OnNextLevel" />
        <Separator />
        <MenuItem Header="_Check the object lists" Click="OnCheckLevel" IsEnabled="{Binding HasGame}" />
        <MenuItem Header="_Find in all levels…" Click="OnFindAll" InputGesture="Ctrl+Shift+F" IsEnabled="{Binding HasGame}" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="_Conversations…" Click="OnConversations" InputGesture="Ctrl+Shift+C" IsEnabled="{Binding HasGame}" />
        <MenuItem Header="_Global variables…" Click="OnGlobals" InputGesture="Ctrl+Shift+G" IsEnabled="{Binding HasGame}" />
        <MenuItem Header="_Player and inventory…" Click="OnPlayer" InputGesture="Ctrl+Shift+P" IsEnabled="{Binding HasGame}" />
        <MenuItem Header="G_raphics…" Click="OnGraphics" InputGesture="Ctrl+Shift+R" IsEnabled="{Binding HasGame}" />
        <MenuItem Header="3D m_odels…" Click="OnModels" InputGesture="Ctrl+Shift+O" IsEnabled="{Binding HasGame}" />
        <Separator />
        <Separator />
        <MenuItem Header="_Keys and locks…" Click="OnKeys" InputGesture="Ctrl+Shift+K" IsEnabled="{Binding HasGame}" />
        <MenuItem Header="_Triggers and traps…" Click="OnTriggers" InputGesture="Ctrl+Shift+T" IsEnabled="{Binding HasGame}" />
        <MenuItem Header="_Strings…" Click="OnStrings" InputGesture="Ctrl+Shift+S" IsEnabled="{Binding HasGame}" />
        <Separator />
        <MenuItem Header="_Mods…" Click="OnMods" InputGesture="Ctrl+Shift+M" IsEnabled="{Binding HasGame}" />
        <Separator />
        <MenuItem Header="Randomi_zer (work in progress)">
          <MenuItem Header="_Zones…" Click="OnZones" IsEnabled="{Binding HasGame}" />
          <MenuItem Header="Zone _graph…" Click="OnZoneGraph" IsEnabled="{Binding HasGame}" />
          <Separator />
          <MenuItem Header="_Shuffle item properties…" Click="OnItemShuffle" IsEnabled="{Binding HasGame}" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Manual" InputGesture="F1" Click="OnManual" />
        <MenuItem Header="_Controls" Click="OnControls" />
        <MenuItem Header="_About" Click="OnAbout" />
      </MenuItem>
    </Menu>

    <!-- status bar -->
    <Border DockPanel.Dock="Bottom" Classes="status">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="{Binding HoverText}" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding StartText}" Margin="16,0" />
        <TextBlock Grid.Column="2" Text="{Binding ViewText}" />
      </Grid>
    </Border>

    <Grid x:Name="Columns" ColumnDefinitions="290,4,*,4,360">

      <!-- left: level and objects -->
      <Border Grid.Column="0" Classes="panel" Padding="14,10,10,10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Classes="h first" Text="GAME" />
            <TextBlock Text="{Binding GameTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding GameFolder}" Classes="muted" Margin="0,2,0,0" />
            <Button Content="Open game folder…" Click="OnOpen" Margin="0,10,0,0" IsVisible="{Binding NoGame}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />

            <StackPanel IsVisible="{Binding HasGame}">
              <TextBlock Classes="h" Text="LEVEL" />
              <ComboBox ItemsSource="{Binding Worlds}" SelectedIndex="{Binding WorldIndex}" IsVisible="{Binding IsUw2}"
                        HorizontalAlignment="Stretch" Margin="0,0,0,6" />
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Content="‹" Click="OnPreviousLevel" Padding="10,4" ToolTip.Tip="Previous level (PgUp)" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding LevelsInWorld}" SelectedItem="{Binding SelectedSlot}"
                          HorizontalAlignment="Stretch" Margin="6,0">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:LevelSlot">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Content="›" Click="OnNextLevel" Padding="10,4" ToolTip.Tip="Next level (PgDn)" />
              </Grid>
              <TextBlock Text="{Binding LevelSummary}" Classes="muted" Margin="0,6,0,0" />
            </StackPanel>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" IsVisible="{Binding HasGame}">
            <TextBlock Classes="h" Text="SHOW" />
            <WrapPanel>
              <CheckBox Content="Ceiling" IsChecked="{Binding ShowCeiling}" Margin="0,0,14,0" />
              <CheckBox Content="Objects" IsChecked="{Binding ShowObjects}" Margin="0,0,14,0" />
              <CheckBox Content="Invisible" IsChecked="{Binding ShowInvisible}" Margin="0,0,14,0" />
              <CheckBox Content="Traps and triggers" IsChecked="{Binding ShowTraps}" Margin="0,0,14,0" />
              <CheckBox Content="3D models" IsChecked="{Binding ShowModels}" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,2">
              <TextBlock Text="Light" VerticalAlignment="Center" FontSize="12" />
              <ComboBox x:Name="LightBox" ItemsSource="{Binding LightChoices}" SelectedIndex="{Binding LightIndex}" Width="220" FontSize="12"
                        ToolTip.Tip="Full light, or the game's own light: the shading the player sees with no light, a candle, a torch, a lantern and so on (SHADES.DAT, LIGHT.DAT), round the point looked at (the eye in first person)." />
            </StackPanel>
            <TextBlock Text="{Binding LightNote}" Classes="muted" FontSize="11" IsVisible="{Binding Darkness}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
              <CheckBox Content="Grid every" IsChecked="{Binding ShowGrid}" />
              <NumericUpDown Value="{Binding GridStep}" Minimum="1" Maximum="32" Increment="1" FormatString="0"
                             Width="104" IsEnabled="{Binding ShowGrid}" VerticalAlignment="Center" />
              <TextBlock Text="tiles" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>
          </StackPanel>

          <DockPanel IsVisible="{Binding HasGame}">
            <TextBlock DockPanel.Dock="Top" Classes="h" Text="OBJECTS" />
            <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Text="{Binding Filter}" Margin="0,0,0,6"
                     PlaceholderText="Search: name, text, #index, 0x item id"
                     ToolTip.Tip="Matches item names, NPC names, the text of books, scrolls, writings, gravestones and text traps, #index or 0x item id." />
            <ItemsControl x:Name="QuickFilterBar" DockPanel.Dock="Top" ItemsSource="{Binding QuickFilters}" Margin="0,0,0,4">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="app:QuickFilter">
                  <ToggleButton Classes="chip" Content="{Binding Label}" IsChecked="{Binding IsOn, Mode=TwoWay}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
              <TextBlock x:Name="ListSummaryText" Text="{Binding ListSummary}" Classes="muted" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Find in all levels…" Click="OnFindAll" Padding="8,3" FontSize="12"
                      ToolTip.Tip="Search every level of the game (Ctrl+Shift+F)" />
            </Grid>
            <TreeView x:Name="ObjectTree" ItemsSource="{Binding Tree}" SelectedItem="{Binding SelectedNode}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <TreeView.Styles>
                <Style Selector="TreeViewItem" x:DataType="app:TreeNode">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
              </TreeView.Styles>
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="app:TreeNode" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="{Binding Icon}" Width="16" Height="16" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                    <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </DockPanel>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <!-- centre: the 3D view -->
      <DockPanel Grid.Column="2">
      <Border DockPanel.Dock="Top" Classes="toolbar" IsVisible="{Binding HasGame}">
        <WrapPanel>
          <ComboBox x:Name="ToolBox" ItemsSource="{Binding Tools}" SelectedIndex="{Binding ToolIndex}" Width="96" Margin="0,0,6,0"
                    ToolTip.Tip="Select: click picks. Move: click a tile to move the selected object there. Paint: drag over tiles with the brush." />
          <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsPainting}" Margin="0,0,6,0">
            <ComboBox x:Name="PaintModeBox" ItemsSource="{Binding PaintModes}" SelectedIndex="{Binding PaintMode}" Width="140" />
            <ComboBox x:Name="SlotBox" ItemsSource="{Binding Slots}" SelectedIndex="{Binding PaintSlot}" IsVisible="{Binding PaintsTexture}" Width="170">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="app:SlotItem">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="{Binding Picture}" Width="20" Height="20" RenderOptions.BitmapInterpolationMode="None" />
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox ItemsSource="{Binding TileTypes}" SelectedIndex="{Binding PaintType}" IsVisible="{Binding PaintsType}" Width="150" />
            <NumericUpDown Value="{Binding PaintHeight}" Minimum="0" Maximum="15" Increment="1" FormatString="0" IsVisible="{Binding PaintsHeight}" Width="100" />
          </StackPanel>
          <Button Content="Add…" Click="OnAddObject" ToolTip.Tip="Add an object on the selected tile or into the selected container (Insert)" />
          <Button Content="Delete" Click="OnDeleteObject" IsEnabled="{Binding HasObject}" ToolTip.Tip="Delete the selected object and what is inside it (Del)" />
          <Button Content="↶" Click="OnUndo" IsEnabled="{Binding CanUndo}" ToolTip.Tip="{Binding UndoText}" />
          <Button Content="↷" Click="OnRedo" IsEnabled="{Binding CanRedo}" ToolTip.Tip="{Binding RedoText}" />
          <Button Content="Save levels" Click="OnSaveLevels" IsEnabled="{Binding HasLevelChanges}" ToolTip.Tip="{Binding ChangedLevels}" />
          <ToggleButton x:Name="WalkButton" Content="First person" Click="OnFirstPerson" ToolTip.Tip="Walk through the level (P; Esc to leave)" />
          <TextBlock Text="{Binding EditStatus}" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="420" />
        </WrapPanel>
      </Border>
      <Panel Background="#0E0E12">
        <app:LevelView x:Name="View" />
        <Canvas x:Name="GridLabels" IsHitTestVisible="False" ClipToBounds="True" />
        <TextBlock x:Name="ViewHint" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" FontSize="14" IsVisible="{Binding NoGame}"
                   Text="File ▸ Open game folder… (Ctrl+O)&#10;Choose the game folder, its DATA folder or a SAVE folder." />
      </Panel>
      </DockPanel>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

      <!-- right: properties -->
      <Border Grid.Column="4" Classes="panel">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="14,10,16,14">
          <StackPanel>
            <TextBlock Classes="h first" Text="OBJECT" />
            <Grid ColumnDefinitions="Auto,*">
              <Border Grid.Column="0" Classes="thumb" Width="42" Height="42" Margin="0,0,10,0" IsVisible="{Binding HasObject}">
                <Image Source="{Binding ObjectThumb}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" Margin="3" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="title" Text="{Binding ObjectTitle}" />
                <TextBlock Classes="muted" Text="{Binding ObjectSubtitle}" Margin="0,2,0,0" />
              </StackPanel>
            </Grid>
            <StackPanel IsVisible="{Binding IsTrapSelected}" Margin="0,10,0,0" Spacing="6">
              <WrapPanel>
                <Button x:Name="PickTargetButton" Content="Choose the target in the view" Click="OnPickTarget" IsVisible="{Binding HasTargetSquare}" Margin="0,0,6,6"
                        ToolTip.Tip="Then click the square it should act on (the bullseye). A teleport can aim at another level: change level, then click." />
                <Button Content="Chains…" Click="OnTriggers" Margin="0,0,6,6" ToolTip.Tip="Every trigger of the level and the traps it sets off (Ctrl+Shift+T)" />
                <Button Content="Variable in globals…" Click="OnTrapVariable" IsVisible="{Binding HasTrapVariable}" Margin="0,0,6,6"
                        ToolTip.Tip="Open the global variables window on the variable this trap sets or checks" />
              </WrapPanel>
              <Border Background="{DynamicResource PanelAlt}" CornerRadius="4" Padding="10,8">
                <SelectableTextBlock x:Name="TrapHelp" Text="{Binding ObjectHelp}" TextWrapping="Wrap" FontSize="12" LineHeight="17" />
              </Border>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding ObjectRows}" Margin="0,8,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:PropertyRow">
                  <app:PropertyRowView />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel IsVisible="{Binding HasTile}">
              <TextBlock Classes="h" Text="TILE" />
              <TextBlock Text="{Binding TileTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,4" Spacing="12">
                <StackPanel Spacing="3">
                  <Border Classes="thumb"><Image Source="{Binding WallThumb}" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" /></Border>
                  <TextBlock Classes="muted" Text="Wall" HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel Spacing="3">
                  <Border Classes="thumb"><Image Source="{Binding FloorThumb}" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" /></Border>
                  <TextBlock Classes="muted" Text="Floor" HorizontalAlignment="Center" />
                </StackPanel>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding TileRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:PropertyRow">
                    <app:PropertyRowView />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</Window>
