<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:UwEditor.App"
        xmlns:g="clr-namespace:UwEditor.Core.Graphics;assembly=UwEditor.Core"
        x:Class="UwEditor.App.GraphicsWindow"
        x:DataType="app:GraphicsViewModel"
        Title="Graphics"
        Width="1280" Height="820" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Border.stage">
      <Setter Property="Background" Value="#0B0C0E" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="panel" Padding="12,8" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Text="Graphics" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
        <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   Text="Export writes an indexed PNG with the picture's own colours. Import refuses another size and colours the picture cannot use, unless you take the nearest ones." />
        <CheckBox Grid.Column="2" x:Name="NearestBox" Content="Use the nearest colours" IsChecked="{Binding Nearest, Mode=TwoWay}" Margin="12,0,0,0"
                  ToolTip.Tip="On import, give a colour the picture's table lacks the nearest one it has (otherwise the import is refused)" />
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Classes="status">
      <TextBlock x:Name="StatusText" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
    </Border>

    <TabControl x:Name="Tabs" Margin="12,6,12,8">
      <!-- pictures -->
      <TabItem Header="Pictures" x:Name="PicturesTab">
        <Grid ColumnDefinitions="170,8,*,8,420" Margin="0,6,0,0">
          <ListBox x:Name="FileList" ItemsSource="{Binding Files}" SelectedItem="{Binding FileName, Mode=TwoWay}" Background="{DynamicResource Panel}" FontSize="12" />
          <ListBox Grid.Column="2" x:Name="ThumbList" ItemsSource="{Binding PictureThumbs}" SelectedItem="{Binding PictureThumb, Mode=TwoWay}" Background="{DynamicResource Bg}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
              <Style Selector="ListBoxItem"><Setter Property="Padding" Value="4" /></Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="app:Thumb">
                <StackPanel Width="76">
                  <Border Height="66" Background="#0B0C0E">
                    <Image Source="{Binding Bitmap}" Width="{Binding Width}" Height="{Binding Height}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                  </Border>
                  <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <DockPanel Grid.Column="4">
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
              <TextBlock x:Name="PictureInfoText" Text="{Binding PictureInfo}" TextWrapping="Wrap" FontSize="12" />
              <ComboBox x:Name="PaletteBox" ItemsSource="{Binding PaletteNames}" SelectedIndex="{Binding PaletteIndex, Mode=TwoWay}" HorizontalAlignment="Stretch"
                        ToolTip.Tip="PALS.DAT palette to show (and match colours) with" />
              <WrapPanel>
                <Button x:Name="ExportPictureButton" Content="Export PNG…" Click="OnExportPicture" IsEnabled="{Binding HasPicture}" Margin="0,0,6,6" />
                <Button x:Name="ImportPictureButton" Content="Import PNG…" Click="OnImportPicture" IsEnabled="{Binding HasPicture}" Margin="0,0,6,6" />
                <Button Content="Revert" Click="OnRevertPicture" IsEnabled="{Binding HasPicture}" Margin="0,0,6,6" />
                <Button x:Name="SavePicturesButton" Content="Save file" Click="OnSavePictures" Margin="0,0,6,6" />
              </WrapPanel>
            </StackPanel>
            <Border Classes="stage">
              <Image x:Name="PicturePreview" Source="{Binding Preview}" Stretch="Uniform" StretchDirection="Both" Margin="8" RenderOptions.BitmapInterpolationMode="None" />
            </Border>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- critter animations -->
      <TabItem Header="Critter animations" x:Name="CrittersTab">
        <Grid ColumnDefinitions="230,8,230,8,*" Margin="0,6,0,0">
          <ListBox x:Name="CritterList" ItemsSource="{Binding Critters}" SelectedItem="{Binding Critter, Mode=TwoWay}" Background="{DynamicResource Panel}" FontSize="12" />
          <DockPanel Grid.Column="2">
            <ComboBox DockPanel.Dock="Bottom" x:Name="AuxBox" ItemsSource="{Binding AuxNames}" SelectedIndex="{Binding AuxPalette, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,8,0,0"
                      ToolTip.Tip="The page's auxiliary palette: critters that share art differ by it" />
            <ListBox x:Name="AnimationList" ItemsSource="{Binding Animations}" SelectedItem="{Binding Animation, Mode=TwoWay}" Background="{DynamicResource Panel}" FontSize="12" />
          </DockPanel>
          <DockPanel Grid.Column="4">
            <ListBox DockPanel.Dock="Bottom" x:Name="FrameStrip" ItemsSource="{Binding FrameThumbs}" Height="110" Background="{DynamicResource Bg}" Margin="0,8,0,0"
                     SelectedIndex="{Binding FrameIndex, Mode=TwoWay}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="app:Thumb">
                  <StackPanel>
                    <Border Height="76" Width="76" Background="#0B0C0E">
                      <Image Source="{Binding Bitmap}" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapInterpolationMode="None" />
                    </Border>
                    <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
              <TextBlock x:Name="CritterInfoText" Text="{Binding CritterInfo}" TextWrapping="Wrap" FontSize="12" />
              <WrapPanel>
                <Button x:Name="PlayCritterButton" Content="Play" Click="OnPlayCritter" Margin="0,0,6,6" MinWidth="70" />
                <Button Content="Export frame…" Click="OnExportFrame" Margin="0,0,6,6" />
                <Button x:Name="ImportFrameButton" Content="Import frame…" Click="OnImportFrame" Margin="0,0,6,6" />
                <Button Content="Save critter" Click="OnSaveCritter" Margin="0,0,6,6" ToolTip.Tip="Write the changed page files (old ones kept as .BKP)" />
              </WrapPanel>
            </StackPanel>
            <Border Classes="stage">
              <Image x:Name="CritterPreview" Source="{Binding CritterPreview}" Stretch="Uniform" Margin="12" RenderOptions.BitmapInterpolationMode="None" MaxWidth="560" MaxHeight="420" />
            </Border>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- cutscenes -->
      <TabItem Header="Cutscenes" x:Name="CutscenesTab">
        <Grid ColumnDefinitions="260,8,*" Margin="0,6,0,0">
          <DockPanel>
            <ListBox DockPanel.Dock="Bottom" x:Name="CutFileList" ItemsSource="{Binding CutsceneFiles}" SelectedItem="{Binding CutsceneFile, Mode=TwoWay}" Height="200"
                     Background="{DynamicResource Panel}" FontSize="12" Margin="0,8,0,0" />
            <ListBox x:Name="CutsceneList" ItemsSource="{Binding Cutscenes}" SelectedItem="{Binding CutsceneItem, Mode=TwoWay}" Background="{DynamicResource Panel}" FontSize="12" />
          </DockPanel>
          <DockPanel Grid.Column="2">
            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
              <Slider x:Name="CutSlider" Minimum="0" Maximum="{Binding CutFrameMax}" Value="{Binding CutFrame, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1" />
              <TextBlock x:Name="CutInfoText" Text="{Binding CutInfo}" TextWrapping="Wrap" FontSize="12" />
              <WrapPanel>
                <Button x:Name="PlayCutButton" Content="Play" Click="OnPlayCut" Margin="0,0,6,6" MinWidth="70" />
                <Button Content="Export frame…" Click="OnExportCutFrame" Margin="0,0,6,6" />
                <Button Content="Export all frames…" Click="OnExportAllCutFrames" Margin="0,0,6,6" />
                <Button x:Name="ImportCutButton" Content="Import frame…" Click="OnImportCutFrame" Margin="0,0,6,6"
                        ToolTip.Tip="Re-encodes this frame and the next one's change; refused when a 64 KB page of the player would overflow" />
                <Button Content="Save animation" Click="OnSaveCutscene" Margin="0,0,6,6" />
              </WrapPanel>
            </StackPanel>
            <Border Classes="stage">
              <Image x:Name="CutPreview" Source="{Binding CutPreview}" Stretch="Uniform" Margin="8" RenderOptions.BitmapInterpolationMode="None" />
            </Border>
          </DockPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
