<Project Sdk="Microsoft.NET.Sdk">
  <!-- The 3D view's drawing, OpenGL 3.3 / GLES 3.0 through Silk.NET. No window toolkit here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGL" Version="$(SilkVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../UwEditor.Core/UwEditor.Core.csproj" />
  </ItemGroup>
</Project>
