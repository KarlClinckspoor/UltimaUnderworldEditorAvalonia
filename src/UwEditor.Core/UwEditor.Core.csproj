<Project Sdk="Microsoft.NET.Sdk">
  <!-- The editor without any UI or GL: opening games, levels, geometry, picking. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UwEditor.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Underworld.Formats/Underworld.Formats.csproj" />
    <ProjectReference Include="../Underworld.Mods/Underworld.Mods.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- the randomizer's hand-written UW1 facts, every docs/facts/uw1-*.json (Randomizer/Facts.cs FactSet.Shipped) -->
    <EmbeddedResource Include="../../docs/facts/uw1-*.json" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
